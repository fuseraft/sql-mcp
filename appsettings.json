{
  "App": {
    "Urls": "http://localhost:8080",
    "AgentTokens": {},
    "AllowedOrigins": [],
    "MaxRows": 1000,
    "QueryTimeoutSeconds": 30,
    "MaxValueLength": 10000,
    "MaxResultBytes": 4000000,
    "MaxConcurrentQueries": 8
  },
  "Databases": [
    {
      "Name": "sampleSql",
      "Provider": "SqlServer",
      "ConnectionString": "Server=localhost;Database=testdb;User Id=agent;Password={password};TrustServerCertificate=true;",
      "PasswordEnvVar": "DB_SAMPLESQL_PASSWORD"
    },
    {
      "Name": "sampleOracle",
      "Provider": "Oracle",
      "ConnectionString": "Data Source=localhost:1521/ORCL;User Id=agent;Password={password};",
      "PasswordEnvVar": "DB_SAMPLEORACLE_PASSWORD"
    },
    {
      "Name": "samplePostgres",
      "Provider": "Postgres",
      "ConnectionString": "Host=localhost;Database=testdb;Username=agent;Password={password};",
      "PasswordEnvVar": "DB_SAMPLEPG_PASSWORD"
    },
    {
      "Name": "sampleMySql",
      "Provider": "MySql",
      "ConnectionString": "Server=localhost;Database=testdb;User Id=agent;Password={password};",
      "PasswordEnvVar": "DB_SAMPLEMYSQL_PASSWORD"
    }
  ],
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
